{
  "name": "@agegr/pi-web",
  "version": "0.8.7",
  "private": true,
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/Intellinfinity/edupi-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intellinfinity/edupi-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/Intellinfinity/edupi-desktop/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 30141",
    "dev:edupi-c1-checkpoint": "node scripts/run-edupi-c1-visible-checkpoint.mjs",
    "dev:lan": "next dev --webpack -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "desktop:dev": "node scripts/desktop-dev.mjs --config src-tauri/tauri.dev.conf.json",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run desktop:prepare && tauri build",
    "release:manifest": "node scripts/write-component-versions.mjs",
    "release:verify": "node scripts/verify-release-components.mjs",
    "drift": "node scripts/measure-fork-drift.mjs",
    "test:release-tools": "node --test scripts/*.test.mjs",
    "test:edupi-status": "node --experimental-strip-types scripts/test-edupi-status.mjs",
    "test:edupi-c1-e2": "node scripts/test-edupi-c1-e2.mjs",
    "test:edupi-ambient-today-runtime": "node scripts/test-edupi-ambient-today-runtime.mjs",
    "test:edupi-chat-capture-e2": "node scripts/test-edupi-chat-capture-e2.mjs",
    "test:edupi-c2-e2": "node scripts/test-edupi-c2-e2.mjs",
    "test:edupi-c3-e2": "node scripts/test-edupi-c3-e2.mjs",
    "test:edupi-follow-up-e2": "node scripts/test-edupi-follow-up-e2.mjs",
    "test:edupi-calendar-dedupe-e2": "node scripts/test-edupi-calendar-dedupe-e2.mjs",
    "test:staged-desktop-runtime": "node scripts/test-staged-desktop-runtime.mjs",
    "test:staged-feedback-runtime": "node scripts/test-staged-feedback-runtime.mjs",
    "test:edupi-c6-e2": "node scripts/test-edupi-c6-e2.mjs",
    "test:edupi-c6-recognition-e2": "node scripts/test-edupi-c6-recognition-e2.mjs",
    "test:edupi-task-board-write-e2": "node scripts/test-edupi-task-board-write-e2.mjs",
    "test:edupi-memory-update-e2": "node scripts/test-edupi-memory-update-e2.mjs",
    "test:edupi-student-profile-update-e2": "node scripts/test-edupi-student-profile-update-e2.mjs",
    "test:edupi-student-profile-versions-e2": "node scripts/test-edupi-student-profile-versions-e2.mjs",
    "test:edupi-student-events-e2": "node scripts/test-edupi-student-events-e2.mjs",
    "test:edupi-teacher-context-versions-e2": "node scripts/test-edupi-teacher-context-versions-e2.mjs",
    "test:edupi-teaching-priorities-e2": "node scripts/test-edupi-teaching-priorities-e2.mjs",
    "test:edupi-material-metadata-e2": "node scripts/test-edupi-material-metadata-e2.mjs",
    "test:edupi-fact-lifecycle-e2": "node scripts/test-edupi-fact-lifecycle-e2.mjs",
    "test:edupi-entity-delete-e2": "node scripts/test-edupi-entity-delete-e2.mjs",
    "test:edupi-living-flow-e2": "node scripts/test-edupi-living-flow-e2.mjs",
    "test:packaged-background-recovery": "node scripts/test-packaged-background-recovery.mjs",
    "test:edupi-teaching-before-class-e2": "node scripts/test-edupi-teaching-before-class-e2.mjs",
    "test:edupi-teacher-created-preparation-e2": "node scripts/test-edupi-teacher-created-preparation-e2.mjs",
    "test:edupi-fact-identity-e2": "node scripts/test-edupi-fact-identity-e2.mjs",
    "test:edupi-c1-visible": "node --test scripts/run-edupi-c1-visible-checkpoint.test.mjs",
    "test": "node --test 'app/**/*.test.mjs' 'lib/**/*.test.mjs' 'scripts/**/*.test.mjs' 'components/**/*.test.mjs' 'hooks/**/*.test.mjs' 'desktop/**/*.test.mjs'",
    "security:audit": "npm audit --audit-level=high",
    "lint": "eslint . && npm run check:branding",
    "check:branding": "node --test lib/branding.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xmldom/xmldom": "0.8.15",
    "jszip": "3.10.1",
    "next": "16.3.4",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typebox": "1.3.8",
    "undici": "8.10.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.17.0",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
