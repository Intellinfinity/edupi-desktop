{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EduPi",
  "version": "pi-agent-desktop-package.json",
  "identifier": "com.abcwyc.pi-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:30141",
    "frontendDist": "../desktop/frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* https: ws: wss:; img-src 'self' data: blob: http://127.0.0.1:* https:; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:*; font-src 'self' data:; frame-src 'self' blob: data: http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "capabilities": ["desktop-updater", "window-controls", "desktop-dialog"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "copyright": "Copyright © EduPi contributors",
    "shortDescription": "教师教育工作台与本地 AI 协作工具",
    "longDescription": "EduPi 教师教育工作台：在本地管理教学任务、材料、课程节奏、证据和教师审核。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": ["resources/server", "resources/Pi Agent Server.app", "resources/component-versions.json", "resources/third-party", "resources/edupi-core", "resources/open-connector"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/Intellinfinity/edupi-desktop/updater-feed/latest.json",
        "https://raw.githubusercontent.com/PIGU-PPPgu/edupi-desktop/updater-feed/latest.json",
        "https://github.com/PIGU-PPPgu/edupi-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
